    "img_data = 255.0 - img_array.reshape(784)\n",
    "img_data = ((img_data/255.0)*0.99) + 0.01\n",
    "#matplotlib.pyplot.imshow(numpy.asfarray(img_data).reshape((28,28)),cmap = 'Greys') # construct a graphic object #\n",
