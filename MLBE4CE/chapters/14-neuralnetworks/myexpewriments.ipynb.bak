    "matplotlib.pyplot.show() # show the graphic object to a window #\n",
    "matplotlib.pyplot.close('all')\n",
    "m0=img_data.mean()  # gather some statistics\n",
    "v0=img_data.var()\n",
    "print(\"mean :\",round(m0,3),\"variance :\",round(v0,3))"
   ]
